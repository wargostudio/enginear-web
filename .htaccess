# Enginear · raíz del repositorio.
# El despliegue Git de Hostinger copia el repositorio entero en public_html.
# Esta regla sirve solo dist/ (el sitio compilado) sin cambiar las URLs:
# src/, tools/, originals/, los .md y la carpeta .git quedan inaccesibles.
# Si en cambio se sube el contenido de dist/ directo a public_html, este
# archivo no se usa (dist/ trae su propio .htaccess).

Options -Indexes
DirectoryIndex index.html
# Página 404 propia (/404.html se reescribe a dist/404.html). Hace falta
# declararla acá: el servidor de Hostinger no toma la de dist/.htaccess.
ErrorDocument 404 /404.html

# Código fuente, herramientas y archivos de configuración: nunca se sirven
# (mod_alias se hereda a las subcarpetas aunque tengan su propio .htaccess).
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(src|tools|originals|\.git)(/|$)
</IfModule>
<FilesMatch "^\.(ht|git)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Todo pasa por dist/ (la URL no cambia). Las reglas de dist/.htaccess
  # (HTTPS, caché, seguridad, 404, redirecciones) se aplican después.
  RewriteRule ^dist/ - [L]

  # Rutas que no existen en dist/ → página 404 propia (vía PHP, con código 404).
  # Resguardo: solo se aplica si DOCUMENT_ROOT apunta bien a esta carpeta
  # (existe dist/index.html); si no, se saltea y el sitio sigue funcionando.
  # (Las URLs del WordPress anterior siguen a dist/, que las redirige.)
  RewriteCond $1 !^(index\.php|wp-admin|wp-login\.php|xmlrpc\.php)
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 !-d
  RewriteRule ^(.*)$ dist/404.php [L]

  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

# Si mod_rewrite no estuviera disponible, no se sirve nada de la raíz.
<IfModule !mod_rewrite.c>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</IfModule>
